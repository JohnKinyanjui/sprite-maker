{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprite Studio",
  "version": "0.3.2",
  "identifier": "com.johnkinyanjui.sprite-studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Sprite Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "John Kinyanjui",
    "copyright": "Copyright © 2026 John Kinyanjui",
    "shortDescription": "Local-first AI workbench for 2D game art",
    "longDescription": "Create, animate, test, organize, and export sprites, tilesets, VFX, and asset packs with an on-device AI agent.",
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
